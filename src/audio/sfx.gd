class_name Sfx
extends Node
## Plays the game's sound effects (assets/sfx/, generated by tools/make_sfx.py) on a small
## pool of players, so overlapping sounds don't cut each other off. Volume comes from
## Settings.sfx_volume. Presenters own one each and call play() on game events.

const SOUNDS: Dictionary = {
	"question": preload("res://assets/sfx/question.wav"),
	"answer_tick": preload("res://assets/sfx/answer_tick.wav"),
	"answer_yes": preload("res://assets/sfx/answer_yes.wav"),
	"answer_no": preload("res://assets/sfx/answer_no.wav"),
	"answer_unclear": preload("res://assets/sfx/answer_unclear.wav"),
	"your_turn": preload("res://assets/sfx/your_turn.wav"),
	"solved": preload("res://assets/sfx/solved.wav"),
	"wrong": preload("res://assets/sfx/wrong.wav"),
	"reveal": preload("res://assets/sfx/reveal.wav"),
	"win": preload("res://assets/sfx/win.wav"),
	"deal": preload("res://assets/sfx/deal.wav"),
}
const VOICES: int = 6

## The sounds played so far, newest last (tests read it; capped).
var history: PackedStringArray = []

var _players: Array[AudioStreamPlayer] = []
var _next: int = 0


func _ready() -> void:
	for i: int in VOICES:
		var player := AudioStreamPlayer.new()
		add_child(player)
		_players.append(player)


## Plays [param sound] (a key of SOUNDS) [param volume_db] relative to the settings volume.
func play(sound: String, volume_db: float = 0.0, pitch: float = 1.0) -> void:
	var stream: AudioStream = SOUNDS.get(sound)
	if stream == null:
		push_warning("Unknown sound %s" % sound)
		return
	history.append(sound)
	if history.size() > 64:
		history = history.slice(-64)
	var volume: float = Settings.sfx_volume
	if volume <= 0.0 or _players.is_empty():
		return
	var player: AudioStreamPlayer = _players[_next]
	_next = (_next + 1) % _players.size()
	player.stream = stream
	player.volume_db = linear_to_db(volume) + volume_db
	player.pitch_scale = pitch
	player.play()
